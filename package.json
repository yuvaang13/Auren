{
  "name": "auren-guardrail",
  "productName": "auren",
  "version": "0.5.0",
  "private": true,
  "description": "Auren — system-wide network-level protection for AI-agent sessions: block websites, apps, terminal access, and autofill from one biometric-gated switch.",
  "license": "SEE LICENSE IN LICENSE",
  "main": "src/main.js",
  "scripts": {
    "start": "bash scripts/dev-app.sh",
    "start:win": "scripts\\start-win.cmd",
    "test": "npm run test:all",
    "test:unit": "node test/unit.test.js && node test/platform.test.js && node test/autoprotect.test.js",
    "test:classifier": "node test/sensitive.test.js && node test/commands.test.js",
    "test:bridge": "node test/agentgate.test.js && node test/bridge.test.js",
    "test:dns": "node test/dns-server.test.js",
    "test:proxy": "node test/proxy.test.js",
    "test:autoprotect": "node test/autoprotect.test.js && node test/agenttrack.test.js",
    "test:detection": "node test/agent-detection.test.js && node test/coverage.test.js",
    "test:fsguard": "node test/fsguard.test.js",
    "test:all": "npm run test:unit && npm run test:classifier && npm run test:bridge && npm run test:dns && npm run test:proxy && npm run test:fsguard && npm run test:autoprotect && npm run test:detection",
    "demo:bridge": "node scripts/demo-agent-bridge.mjs",
    "e2e:check": "bash scripts/e2e-check.sh",
    "e2e:check:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\e2e-check.ps1",
    "install:daemon": "bash scripts/install-daemon.sh",
    "install:daemon:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\install-daemon.ps1",
    "e2e:pf": "bash scripts/e2e-pf-check.sh",
    "e2e:apps": "bash scripts/e2e-apps-check.sh",
    "audit:container": "bash scripts/audit-container-block.sh",
    "icon": "electron scripts/make-icon.js && node scripts/make-ico.js && node scripts/gen-icon.js",
    "dist": "npm run icon && electron-builder",
    "dist:mac": "npm run icon && electron-builder --mac",
    "dist:win": "npm run icon && electron-builder --win",
    "dist:win:dir": "npm run icon && electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "^44.1.0",
    "electron-builder": "^26.18.0"
  }
}